{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "tasks": {
    "dev": {
      "command": "vinxi dev",
      "dependencies": ["setup", "gen_docs_nav"]
    },
    "build": { "command": "vinxi build", "dependencies": ["gen_docs_nav"] },
    "start": "vinxi start",
    "version": "vinxi version",
    "commit_lint": "commitlint --edit -V",
    "version_update": "./versionup.sh",
    "citation_validate": "docker run --rm -v $(pwd):/app citationcff/cffconvert --validate",
    "setup": "./setup.sh",
    "test": "vitest run --passWithNoTests",
    "test-watch": "vitest",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "gen_docs_nav": "deno run --allow-read --allow-write ./generate_nav.ts",
    "make_migration": "kysely migrate:make -x ts",
    "make_seed": "kysely seed:make -x ts",
    "migrate": "kysely migrate:latest",
    "codegen_db": "kysely-codegen --dialect libsql"
  },
  "license": "AGPL-3.0-or-later",
  "imports": {
    "@valibot/valibot": "jsr:@valibot/valibot@^1.0.0",
    "solid-js": "npm:solid-js"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "semiColons": true,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "jsr",
        "jsx",
        "recommended"
      ],
      "include": [
        "ban-untagged-todo",
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "guard-for-in",
        "jsx-boolean-value",
        "no-await-in-loop",
        "no-boolean-literal-for-arguments",
        "no-const-assign",
        "no-eval",
        "no-external-import",
        "no-implicit-declare-namespace-export",
        "no-inferrable-types",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-top-level-await",
        "no-undef",
        "no-useless-rename",
        "prefer-ascii",
        "single-var-declarator"
      ],
      "exclude": ["jsx-key"]
    },
    "report": "pretty",
    "exclude": ["./src/components/ui"]
  },
  "unstable": [
    "worker-options",
    "cron",
    "kv"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "deno.ns"
    ]
  }
}
